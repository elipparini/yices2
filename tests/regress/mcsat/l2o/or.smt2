(set-logic QF_NIA)
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(declare-fun w () Int)
(assert (or (= (* x x) (- 1)) (= (* (+ 1 x) x) (* y y))))
(assert (or (= x y) (= x w)))
(assert (= (+ (* z z) (* w w)) 1))
(assert (>= (+ (* (- x z) (- x z)) (* (- y w) (- y w))) 1))
(check-sat)